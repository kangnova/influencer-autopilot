# PostgreSQL — start with `docker compose up -d`
DATABASE_URL="postgresql://autopilot:autopilot@localhost:5437/influencer_autopilot?schema=public"

# LLM (OpenRouter) — used by the pipeline jobs
OPENROUTER_API_KEY="sk-or-..."

# Auth (NextAuth)
NEXTAUTH_SECRET="generate-with: openssl rand -base64 32"
NEXTAUTH_URL="http://localhost:3007"

# Server-side encryption key for stored social tokens
ENCRYPTION_KEY="generate-with: openssl rand -base64 32"

# Distribution (Instagram). Default "manual" = no API calls, no account-ban risk;
# you post by hand and mark posts published manually. Set to "instagram" to use
# the real Graph API (requires an Instagram Business/Creator account + a Facebook
# Page + a token with instagram_content_publish permission).
SOCIAL_PROVIDER="manual"
INSTAGRAM_GRAPH_VERSION="v21.0"
# Public base URL so the Graph API can fetch uploaded media (set to your real
# domain once deployed; keep localhost for dev).
PUBLIC_BASE_URL="http://localhost:3007"

